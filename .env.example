# =============================================================================
# Local development settings. Copy to `.env` (git-ignored) and adjust.
# Every value here is a LOCAL DUMMY. Staging/prod values come from Secrets Manager.
# =============================================================================

# --- docker compose ---------------------------------------------------------
# Change if another Postgres already uses 5432 on your machine (then update the URLs below).
POSTGRES_PORT=5432

# --- API (apps/api) ----------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Runtime role: CRUD only, INSERT-only on audit_log (scripts/dev/postgres-init.sql).
DATABASE_URL=postgres://thaala_app:local-dev-only@127.0.0.1:5432/thaala
# Schema owner: used only by `pnpm db:migrate` and `pnpm db:seed`.
MIGRATE_DATABASE_URL=postgres://thaala_migrate:local-dev-only@127.0.0.1:5432/thaala
CORS_ORIGINS=http://localhost:3000
# Dev sign-in (pick a seeded user). Config refuses AUTH_MODE=dev in production.
AUTH_MODE=dev
DEV_JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
AUDIT_IP_SALT=local-dev-only-audit-salt

# --- Web (apps/web) ----------------------------------------------------------
# Server-side only: where the BFF reaches the API.
API_URL=http://127.0.0.1:8080
# 32+ chars. Encrypts the HttpOnly session cookie.
SESSION_SECRET=local-dev-only-session-secret-0123456789abcdef
NEXT_PUBLIC_ENV=local
